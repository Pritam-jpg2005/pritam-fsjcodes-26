import java.util.Scanner;

class Person {
    private String name;
    private String gender;
    private int age;
    private String mobileNumber;

    Person(String name, String gender, int age, String number) {
        this.name = name;
        this.gender = gender;
        this.age = age;
        this.mobileNumber = number;
    }

    void display() {
        System.out.println("Name: " + name);
        System.out.println("Gender: " + gender);
        System.out.println("Age: " + age);
        System.out.println("Mobile No.: " + mobileNumber);
    }
}

class Employee extends Person {
    private String role;
    private double salary;
    private String employeeId;
    private int experience;

    Employee(String name, String gender, int age, String number,
             String role, double salary, String id, int experience) {

        super(name, gender, age, number);
        this.role = role;
        this.salary = salary;
        this.employeeId = id;
        this.experience = experience;
    }

    void display() {
        super.display();
        System.out.println("Position: " + role);
        System.out.println("Salary: " + salary);
        System.out.println("Employee Id: " + employeeId);
        System.out.println("Experience: " + experience);
    }
}

class Manager extends Employee {
    private String department;
    private int no_of_project_completed;

    Manager(String name, String gender, int age, String number,
            String role, double salary, String id, int experience,
            String department, int project) {

        super(name, gender, age, number, role, salary, id, experience);
        this.department = department;
        this.no_of_project_completed = project;
    }

    void display() {
        super.display();
        System.out.println("Department: " + department);
        System.out.println("Number of project completed: " + no_of_project_completed);
    }
}

